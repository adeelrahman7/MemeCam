{
  "camera": {
    "index": 0,
    "width": 1280,
    "height": 720,
    "mirror": true,
    "swap_handedness": false
  },
  "inference": {
    "model": "models/gesture_recognizer.task",
    "max_width": 640,
    "num_hands": 2,
    "min_detection_confidence": 0.5,
    "min_gesture_score": 0.6
  },
  "debounce": {
    "hold_frames": 6,
    "cooldown_seconds": 1.5
  },
  "overlay": {
    "corner": "top_right",
    "width_fraction": 0.3,
    "margin_px": 16,
    "display_seconds": 2.0
  },
  "custom_gestures": {
    "file": "config/custom_gestures.json",
    "threshold": 0.2,
    "rotation_invariant": false,
    "smoothing": 0.5,
    "release_factor": 1.3,
    "countdown_seconds": 3.0,
    "capture_frames": 45
  },
  "reactions": [
    {
      "gesture": "Thumb_Up",
      "image": "assets/memes/thumbs_up.png"
    },
    {
      "gesture": "Thumb_Down",
      "image": "assets/memes/thumbs_down.png"
    },
    {
      "gesture": "Victory",
      "image": "assets/memes/victory.png"
    },
    {
      "gesture": "Open_Palm",
      "image": "assets/memes/open_palm.png"
    },
    {
      "gesture": "ILoveYou",
      "image": "assets/memes/i_love_you.png"
    }
  ],
  "face": {
    "model": "models/face_landmarker.task",
    "num_faces": 1,
    "min_confidence": 0.5,
    "smoothing": 0.5
  },
  "face_overlays": [
    {
      "image": "assets/face/sunglasses.png",
      "anchor": "eyes",
      "width": 1.4,
      "trigger": "Closed_Fist",
      "linger_seconds": 1.0
    },
    {
      "image": "assets/face/crown.png",
      "anchor": "forehead",
      "width": 1.3,
      "offset_y": -0.45,
      "trigger": "Thumb_Up",
      "linger_seconds": 1.0
    }
  ]
}
